{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // vercel-headers.ts is imported with its extension: Vite warns that its native config loader, planned as the
    // default, cannot resolve an extensionless import in vite.config.ts.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "vercel-headers.ts", "playwright.config.ts"]
}
