{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!fixtures", "!schemas"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noExplicitAny": "warn",
        "noTemplateCurlyInString": "off",
        "noControlCharactersInRegex": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/engine/src/**", "packages/document/src/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" }
        }
      }
    }
  ]
}
