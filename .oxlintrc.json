{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "import/no-cycle": "error",
    "no-console": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-thenable": "off",
    "no-await-in-loop": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "ignorePatterns": ["fixtures/**", "schemas/**", "**/dist/**", "**/coverage/**", ".claude/**"],
  "overrides": [
    {
      "files": ["packages/engine/src/**", "packages/document/src/**", "apps/web/src/**"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@simulci/engine",
                "message": "only src/worker/** runs the engine; the page imports types, or values from @simulci/engine/plan and @simulci/engine/render",
                "allowTypeImports": true
              },
              {
                "name": "@simulci/document",
                "message": "the page holds only @simulci/document/edits, which imports nothing; the document model and its YAML parser load with the edit runtime",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/edit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@simulci/engine",
                "message": "only src/worker/** runs the engine; the page imports types, or values from @simulci/engine/plan and @simulci/engine/render",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/edit/load.ts", "apps/web/src/edit/types.ts", "apps/web/src/edit/gestures.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@simulci/engine",
                "message": "only src/worker/** runs the engine; the page imports types, or values from @simulci/engine/plan and @simulci/engine/render",
                "allowTypeImports": true
              },
              {
                "name": "@simulci/document",
                "message": "load.ts, types.ts and gestures.ts are the page's side of the edit runtime: they hold none of the document model",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
