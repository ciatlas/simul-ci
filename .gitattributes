# Fixtures and snapshots are compared byte for byte; keep LF everywhere.
fixtures/** text eol=lf

# Generated by `pnpm schemas` from the engine's zod schemas.
schemas/** linguist-generated=true

# The document model's fixtures and goldens are compared byte for byte; CRLF variants are made by the tests.
packages/document/test/fixtures/** text eol=lf
packages/document/test/golden/** text eol=lf
