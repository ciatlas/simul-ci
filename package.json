{
  "name": "simulci-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --if-present run build",
    "typecheck": "pnpm -r --filter './packages/*' --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "schemas": "tsx --conditions=source scripts/gen-schemas.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@ciatlas/core": "github:ciatlas/core#c24ccf8",
    "@simulci/engine": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fallow": "^3.33.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
