{
  "$id": "https://ciatlas.github.io/simulci/schemas/scenario/v1.json",
  "title": "simulci scenario",
  "description": "The facts about one run: event, ref, inputs, variables, changed files, actor.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "defaultBranch": {
      "default": "main",
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+\\/[^/\\s]+$"
    },
    "message": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1
        },
        "fork": {
          "default": false,
          "type": "boolean"
        },
        "bot": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "fork",
        "bot"
      ],
      "additionalProperties": false
    },
    "changed": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "default": "modified",
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "renamed"
                ]
              },
              "from": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "inputs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "number"
        ]
      }
    },
    "vars": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "secrets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cron": {
      "type": "string",
      "minLength": 1
    },
    "workflow_run": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "default": "success",
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped"
          ]
        }
      },
      "required": [
        "name",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "platform": {
      "default": "dotcom",
      "type": "string",
      "enum": [
        "dotcom",
        "ghes"
      ]
    }
  },
  "required": [
    "event",
    "defaultBranch",
    "actor",
    "inputs",
    "vars",
    "secrets",
    "platform"
  ],
  "additionalProperties": false
}
