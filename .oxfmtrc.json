{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "ignorePatterns": [
    "fixtures/**",
    "schemas/**",
    "**/dist/**",
    "**/coverage/**",
    ".claude/**",
    "pnpm-lock.yaml",
    "apps/web/src/catalog/catalog.json",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml"
  ]
}
