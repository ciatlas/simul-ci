{
  // The repository formats with oxfmt (.oxfmtrc.json) and lints with oxlint (.oxlintrc.json); CI fails on any
  // difference (`pnpm lint`). These settings make the editor do the same on save, over a user's own formatter. They
  // are per language because a user's [typescript]-style settings take precedence over plain workspace ones.
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // Markdown and YAML are not formatted by the repository: keep them as written.
  "[yaml]": { "editor.formatOnSave": false, "editor.formatOnPaste": false },
  "[github-actions-workflow]": { "editor.formatOnSave": false, "editor.formatOnPaste": false },
  "[markdown]": { "editor.formatOnSave": false, "editor.formatOnPaste": false },
  "[mdx]": { "editor.formatOnSave": false, "editor.formatOnPaste": false },
  // Nothing here is formatted with Prettier or Biome.
  "prettier.enable": false
}
